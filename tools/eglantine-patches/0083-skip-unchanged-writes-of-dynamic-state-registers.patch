@@ -345,6 +345,12 @@ void Maxwell3D::ProcessDirtyRegisters(u32 method, u32 argument) {
     if (draw_manager.HasDeferredDraw() && !DrawManager::IsInstanceLoopMethod(method)) [[unlikely]] {
         draw_manager.DrawDeferred(*this, true);
     }
+    // Of the GPU thread's 3D register writes, 60-72% write the value already there (Mario Kart
+    // World, Donkey Kong Bananza on the PS5); for dynamic state each one only made the next draw
+    // record that state again.
+    if (dirty.skip_same_value[method] && regs.reg_array[method] == argument) {
+        return;
+    }
     regs.reg_array[method] = argument;
     for (auto const& table : dirty.tables)
         dirty.flags[table[method]] = true;

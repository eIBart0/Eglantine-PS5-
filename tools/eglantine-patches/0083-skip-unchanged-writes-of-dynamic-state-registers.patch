     SetupRasterModes(tables);
+    // Writes of an unchanged value can be left out for the registers that only feed dynamic
+    // state (Maxwell3D::DirtyState::skip_same_value). EDEN_NX2_SKIP_SAME_STATE=0: mark them all.
+    static const bool skip_same = [] {
+        const char* value = std::getenv("EDEN_NX2_SKIP_SAME_STATE");
+        return value == nullptr || value[0] != '0';
+    }();
+    auto& skip = channel_state.payload->maxwell_3d.dirty.skip_same_value;
+    skip.reset();
+    if (skip_same) {
+        const auto dynamic = [](u8 flag) {
+            return flag == VideoCommon::Dirty::NullEntry || (flag >= Dirty::Viewports && flag < Dirty::Last);
+        };
+        for (size_t method = 0; method < Maxwell::NUM_REGS; ++method) {
+            const u8 first = tables[0][method];
+            const u8 second = tables[1][method];
+            if ((first != 0 || second != 0) && dynamic(first) && dynamic(second)) {
+                skip.set(method);
+            }
+        }
+    }

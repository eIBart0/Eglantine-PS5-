         Flags flags;
         Tables tables{};
+        // Registers whose write of the value they already hold changes nothing the renderer
+        // tracks: every dirty flag they map to is dynamic state, set again for each new command
+        // buffer anyway (filled by the Vulkan state tracker). Memory-backed state (buffers,
+        // vertex streams, render targets, shaders) always takes the write: Eden marks it on
+        // repeated writes on purpose (eden-emu PR 3712).
+        std::bitset<Regs::NUM_REGS> skip_same_value;

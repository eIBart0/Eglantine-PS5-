diff --git a/src/video_core/engines/puller.cpp b/src/video_core/engines/puller.cpp
index 5b428e139a..ac314fcab9 100644
--- a/src/video_core/engines/puller.cpp
+++ b/src/video_core/engines/puller.cpp
@@ -87,6 +87,16 @@ bool Puller::CanResumeAcquire(DmaPusher& dma_pusher) {
     if (!pending_acquire) {
         return true;
     }
+    // A waiter the split's back already latched (it ran a release that met the value) resumes
+    // without a drain: the scheduler polls a waiting acquire many times, and each poll drained the
+    // back (after zortos293/Lichii PR 231, 475c498c1a, PantACRO4life). EDEN_NX2_SEM_FAST=0: drain.
+    static const bool latched_fast = [] {
+        const char* value = std::getenv("EDEN_NX2_SEM_FAST");
+        return value == nullptr || value[0] != '0';
+    }();
+    if (latched_fast && VideoCommon::GpuSplit::Get().Active() && Nx2SemaphoreWaiters::Get().Latched(this)) {
+        return true;
+    }
     // The release may still be queued for the split GPU thread's back half (and the caches
     // ReadSemaphoreWord asks are its state).
     DrainBack();

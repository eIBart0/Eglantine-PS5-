diff --git a/src/video_core/renderer_vulkan/vk_gpu_time_marks.h b/src/video_core/renderer_vulkan/vk_gpu_time_marks.h
new file mode 100644
index 0000000000..2e6cdfe21e
--- /dev/null
+++ b/src/video_core/renderer_vulkan/vk_gpu_time_marks.h
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <atomic>
+
+#include "common/common_types.h"
+#include "video_core/vulkan_common/vulkan_wrapper.h"
+
+namespace Vulkan::GpuTimeMarks {
+
+/// The kinds of work the GPU time of a submission is split into. A mark starts a kind; it lasts
+/// until the next mark or the end of the submission.
+enum Kind : u32 {
+    Other,    ///< from the start of a submission to its first mark
+    Draw,     ///< graphics draws
+    MeshDraw, ///< task and mesh draws
+    Compute,  ///< the guest's compute dispatches, split by shader (the key)
+    Pass,     ///< the emulator's own compute passes (ASTC decoding)
+    Clear,    ///< clears
+    Present,  ///< the frame's way to the screen (scaling, filters)
+    Count,
+};
+
+/// Set by a frontend that measures the GPU's time (the PS5 port's gpu_time_probe.inc): `write`
+/// puts a timestamp into the command buffer for a mark, on the Vulkan worker thread.
+inline std::atomic<bool> active{false};
+inline void (*write)(VkCommandBuffer cmdbuf, u32 kind, u64 key) = nullptr;
+
+/// The kind recorded last, so a run of work of one kind takes one mark.
+inline u32 last_kind = ~0U;
+inline u64 last_key = ~u64{0};
+
+/// A submission ends: the next mark starts the next command buffer's first kind.
+inline void OnSubmit() noexcept {
+    last_kind = ~0U;
+}
+
+template <typename SchedulerT>
+inline void Mark(SchedulerT& scheduler, u32 kind, u64 key = 0) {
+    if (!active.load(std::memory_order_relaxed) || (kind == last_kind && key == last_key)) {
+        return;
+    }
+    last_kind = kind;
+    last_key = key;
+    scheduler.Record([kind, key](vk::CommandBuffer cmdbuf) {
+        if (write != nullptr) {
+            write(*cmdbuf, kind, key);
+        }
+    });
+}
+
+} // namespace Vulkan::GpuTimeMarks
